APP_ENV=dev

HTTP_HOST=0.0.0.0
HTTP_PORT=8081
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576

DATABASE_URL=postgres://postgres:postgres@localhost:5432/codefight_judge?sslmode=disable

# Set independent random tokens, for example with: openssl rand -hex 32
JUDGE_API_TOKEN=
JUDGE_CALLBACK_URL=http://localhost:8080/internal/judge/callback
JUDGE_CALLBACK_TOKEN=

JUDGE_WORKDIR=/tmp/code-fight/jobs
JUDGE_GO_IMAGE=judge-go:1.24
JUDGE_PYTHON_IMAGE=judge-python:3.12
JUDGE_RUNTIME=runsc
JUDGE_CPU_COUNT=1
JUDGE_DEFAULT_MEMORY_MB=256
JUDGE_DEFAULT_PIDS=64
JUDGE_DEFAULT_TMPFS_MB=64
